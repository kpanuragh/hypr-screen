)


def launch_prompt(result_path, name, addr, code):
    """Open a small floating terminal asking the user to accept the phone. False if none could start."""
    run("hyprctl", "eval", f'hl.window_rule({{ match = {{ class = "{PAIR_CLASS}" }}, float = true, '
        f'center = true, pin = true, size = {{ 620, 330 }} }})', check=False)
    cmd = [sys.executable, os.path.abspath(__file__), "--confirm-pair", result_path, name, addr, code]
    for exe, flags in TERMINALS:
        if shutil.which(exe):
            try:
                subprocess.Popen([exe, *flags, *cmd], start_new_session=True, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except OSError as e:
                log(f"could not start {exe}: {e}")
    return False


def write_result(path, value):
    """First answer wins (the prompt or the daemon cancelling). The file appears complete or not at all."""
    try:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    except OSError:
        return  # the daemon already cleaned up
    try:
        with os.fdopen(fd, "w") as f:
            f.write(value)
        os.link(tmp, path)  # fails if an answer is already there
    except OSError:
        pass
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def confirm_pair(result_path, name, addr, code):
    """Runs inside the terminal window. The user must type the code shown on the phone and press
    Enter, so a keystroke meant for another window can never accept a request."""
    import termios
    import tty
    b, d, r = "\033[1m", "\033[2m", "\033[0m"
    print(f"\n  {b}Hypr Screen: pairing request{r}\n")
    print(f"  Phone   {b}{name}{r}  {d}({addr}){r}\n")
    print("  If this is your phone, type the 6-digit code it shows")
    print(f"  and press Enter. {d}Esc rejects. It can then use this laptop{r}")
    print(f"  {d}as a display and send keys.{r}\n")
    print("  Code: ", end="", flush=True)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    typed, answer = "", None
    try:
        tty.setcbreak(fd)
        time.sleep(0.8)
        termios.tcflush(fd, termios.TCIFLUSH)  # drop anything typed before the window appeared
        end = time.monotonic() + PAIR_SECONDS
        while answer is None and time.monotonic() < end and not os.path.exists(result_path):
            if not select.select([fd], [], [], 0.3)[0]:
                continue
            ch = os.read(fd, 1).decode(errors="ignore")
            if ch == "\x1b":
                answer = "no"
            elif ch.isdigit() and len(typed) < 6:
                typed += ch
                print(ch + (" " if len(typed) == 3 else ""), end="", flush=True)
            elif ch in ("\x7f", "\b") and typed:
                typed = typed[:-1]
                print("\r  Code: " + " " * 8 + "\r  Code: " + typed[:3] + (" " + typed[3:] if len(typed) > 3 else ""),
                      end="", flush=True)
            elif ch in ("\n", "\r") and len(typed) == 6:
                answer = "yes" if hmac.compare_digest(typed, code) else "wrong"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    if answer is None:
        print("\n\n  Request ended." if os.path.exists(result_path) else "\n\n  Timed out.")
    else:
        write_result(result_path, "yes" if answer == "yes" else "no")
        print("\n\n  " + {"yes": "Accepted. Tap Confirm on the phone if you haven't yet.",
                           "wrong": "Wrong code. Request rejected.", "no": "Rejected."}[answer])
    time.sleep(1.5)


class Daemon:
    def __init__(self, cfg, ident):
        self.cfg = cfg
        self.ident = ident
        self.ctx = tls_context(ident)
        self.busy = threading.Lock()
        self.pending = threading.BoundedSemaphore(MAX_PENDING)
        self.pair_lock = threading.Lock()  # one pairing request at a time
        self.pair_quiet_until = 0.0
        self.hostname = socket.gethostname().replace(" ", "-")[:64] or "laptop"

    # ---- TCP: TLS + challenge, then one display session at a time
    def serve(self):
        bind = "0.0.0.0" if self.cfg["wifi"] else "127.0.0.1"
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind((bind, PORT))
        srv.listen(16)
        log(f"listening on {bind}:{PORT} (host {self.hostname}, id {self.ident['id']})")
        while True:
            try:
                conn, addr = srv.accept()
            except OSError as e:  # e.g. EMFILE under load: back off, keep serving
                log(f"accept: {e}")
                time.sleep(0.5)
                continue
            if not self.pending.acquire(blocking=False):
                conn.close()  # too many unauthenticated connections
                continue
            try:
                threading.Thread(target=self.session, args=(conn, addr), daemon=True).start()
            except RuntimeError:
                self.pending.release()
                conn.close()

    def session(self, conn, addr):
        authed = False
        tls = None
        try:
            tls, w, h, dpi = self.handshake(conn, addr)
            if tls is None:
                return
            self.pending.release()
            authed = True
            if not self.busy.acquire(blocking=False):
                tls.sendall(b"BUSY\n")
                return
            try:
                tls.sendall(b"OK\n")
                self.stream(tls, w, h, dpi, "USB" if addr[0] == "127.0.0.1" else addr[0])
            finally:
                self.busy.release()
        except Exception as e:  # keep the daemon alive whatever a client does
            log(f"session from {addr[0]} ended: {e}")
        finally:
            if not authed:
                self.pending.release()
            for s in (tls, conn):
                if s is not None:
                    try:
                        s.close()
                    except OSError:
                        pass

    @staticmethod
    def readline(tls, deadline):
        """One protocol line (max 512 bytes) before the deadline, or None."""
        line = b""
        while not line.endswith(b"\n"):
            left = deadline - time.monotonic()
            if left <= 0 or len(line) > 512:
                return None
            tls.settimeout(left)
            chunk = tls.recv(1)  # byte at a time: never read past the line
            if not chunk:
                return None
            line += chunk
        return line.decode(errors="replace").split()

    def handshake(self, conn, addr):
        """TLS, then: HELLO -> HYPRSCREEN <w> <h> <dpi> <client nonce> <proof> [device].
        Returns (tls, w, h, dpi); tls is None when the connection ends here."""
        deadline = time.monotonic() + HANDSHAKE_SECONDS
        conn.settimeout(HANDSHAKE_SECONDS)
        tls = self.ctx.wrap_socket(conn, server_side=True)
        nonce = os.urandom(16).hex()
        tls.sendall(f"HELLO {PROTO} {self.ident['id']} {self.hostname} {nonce}\n".encode())
        parts = self.readline(tls, deadline)
        if not parts or parts[:1] == ["PING"]:  # PING: availability probe from the app
            return None, 0, 0, 0
        if parts[:2] == ["PAIR", PROTO]:
            self.pair(tls, parts, addr)
            return None, 0, 0, 0
        if len(parts) not in (7, 8) or parts[:2] != ["HYPRSCREEN", PROTO]:
            return None, 0, 0, 0
        try:
            w, h, dpi = int(parts[2]), int(parts[3]), int(parts[4])
        except ValueError:
            return None, 0, 0, 0
        client_nonce, proof = parts[5], parts[6]
        if len(parts) == 8:  # paired over Wi-Fi: per-phone secret
            with DevicesLock():
                secret = load_devices().get(parts[7], {}).get("secret")
        else:  # paired over USB
            secret = self.ident["secret"]
        if not secret or not HEX32.fullmatch(client_nonce) or not hmac.compare_digest(
                proof, mac(secret, "c", nonce, client_nonce)):
            tls.sendall(b"DENIED\n")
            log(f"rejected a device without a valid pairing ({addr[0]})")
            return None, 0, 0, 0
        if not (100 <= w <= 8192 and 100 <= h <= 8192):
            return None, 0, 0, 0
        return tls, w, h, dpi

    # ---- Wi-Fi pairing
    def pair(self, tls, parts, addr):
        """PAIR <proto> <commit> <name> -> PAIRNONCE <ns> -> PAIRREVEAL <nc>, then both users confirm
        the code and the phone gets PAIRED <device id> <secret> (or DENIED)."""
        if len(parts) != 4 or not re.fullmatch(r"[0-9a-f]{64}", parts[2]) or not DEVICE_NAME.fullmatch(parts[3]):
            return
        if not (self.cfg["wifi_pairing"] and self.cfg["wifi"]):
            tls.sendall(b"DENIED\n")
            return
        if time.monotonic() < self.pair_quiet_until or not self.pair_lock.acquire(blocking=False):
            tls.sendall(b"BUSY\n")
            return
        try:
            self._pair(tls, parts[2], parts[3], addr[0])
        finally:
            self.pair_lock.release()

    def _pair(self, tls, commit, name, addr):
        server_nonce = os.urandom(16).hex()
        tls.sendall(f"PAIRNONCE {server_nonce}\n".encode())
        reveal = self.readline(tls, time.monotonic() + HANDSHAKE_SECONDS)
        if not reveal or len(reveal) != 2 or reveal[0] != "PAIRREVEAL" or not HEX32.fullmatch(reveal[1]):
            return
        client_nonce = reveal[1]
        # The phone committed to its nonce before seeing ours, so nobody can steer the code.
        if not hmac.compare_digest(hashlib.sha256(f"hs-commit|{client_nonce}".encode()).hexdigest(), commit):
            return
        code = pair_code(self.ident["fingerprint"], client_nonce, server_nonce)
        log(f"pairing request from {name} ({addr})")
        tmp = tempfile.mkdtemp(prefix="hypr-screen-pair-", dir=os.environ.get("XDG_RUNTIME_DIR"))
        result = os.path.join(tmp, "result")
        outcome = "failed"
        try:
            if not launch_prompt(result, name, addr, code):
                log("no terminal found to ask about the pairing request; install kitty, foot or alacritty")
                tls.sendall(b"DENIED\n")
                return
            outcome = self._await_pair(tls, result)
        finally:
            if outcome != "paired":  # also on errors: no new prompt for a while
                self.pair_quiet_until = time.monotonic() + PAIR_COOLDOWN
            write_result(result, "cancelled")  # closes the prompt if it is still open
            time.sleep(0.5)
            shutil.rmtree(tmp, ignore_errors=True)
        if outcome == "paired":
            device, secret = os.urandom(6).hex(), os.urandom(32).hex()
            with DevicesLock():
                devices = load_devices()
                devices[device] = {"name": name, "secret": secret, "added": int(time.time())}
                save_devices(devices)
            tls.sendall(f"PAIRED {device} {secret}\n".encode())
            log(f"paired {name} over Wi-Fi (device {device})")
            return
        log(f"pairing with {name} {outcome}")
        if outcome == "rejected":
            quietly(tls.sendall, b"DENIED\n")

    def _await_pair(self, tls, result):
        """Wait until both the laptop prompt and the phone accept. Returns paired/rejected/cancelled/timed out."""
        end = time.monotonic() + PAIR_SECONDS
        phone_ok = False
        buf = b""
        while time.monotonic() < end:
            if os.path.exists(result):
                with open(result) as f:
                    answer = f.read().strip()
                if answer != "yes":
                    return "rejected"
                if phone_ok:
                    return "paired"
            tls.settimeout(0.3)
            try:
                chunk = tls.recv(64)
            except (TimeoutError, socket.timeout):
                continue
            except (OSError, ssl.SSLError):
                return "cancelled"
            if not chunk:
                return "cancelled"
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if line.strip() == b"PAIRCONFIRM":
                    phone_ok = True
                else:  # PAIRCANCEL or anything unexpected
                    return "cancelled"
            if len(buf) > 64:
                return "cancelled"
        return "timed out"

    def stream(self, sock, w, h, dpi, via):
        # The TLS socket is used from this thread only (OpenSSL objects aren't thread-safe).
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        for opt, val in (("TCP_KEEPIDLE", 3), ("TCP_KEEPINTVL", 2), ("TCP_KEEPCNT", 3), ("TCP_USER_TIMEOUT", 6000)):
            if hasattr(socket, opt):
                sock.setsockopt(socket.IPPROTO_TCP, getattr(socket, opt), val)

        tmp = tempfile.mkdtemp(prefix="hypr-screen-")
        fifo = os.path.join(tmp, "stream.flv")
        errlog_path = os.path.join(tmp, "wf-recorder.log")
        os.mkfifo(fifo, 0o600)
        rec = touch = keyboard = None
        stop = threading.Event()
        frames = queue.Queue(maxsize=8)
        try:
            add_monitor(w, h, self.cfg)
            log(f"display session via {via}: {w}x{h} scale {self.cfg['scale']}")
            notify("Phone connected as a display", f"{w}×{h} via {via}")
            try:
                map_touch_to_output()
                touch = Touchscreen(w, h, dpi)
                keyboard = Keyboard()
            except OSError as e:
                log(f"touch/keyboard input unavailable: {e}")
            with open(errlog_path, "w") as errlog:
                rec = subprocess.Popen(recorder_cmd(self.cfg, fifo), stdin=subprocess.DEVNULL,
                                       stdout=subprocess.DEVNULL, stderr=errlog)
            threading.Thread(target=flv_frames, args=(fifo, frames, stop), daemon=True).start()
            self.loop(sock, frames, touch, keyboard, rec)
            if rec.poll() is not None:
                with open(errlog_path) as f:
                    tail = f.read().strip().splitlines()[-4:]
                log("wf-recorder exited: " + " | ".join(tail))
        finally:
            stop.set()
            if rec and rec.poll() is None:
                rec.terminate()
                try:
                    rec.wait(2)
                except subprocess.TimeoutExpired:
                    rec.kill()
            try:  # unblock the reader if it is still waiting to open the fifo
                os.close(os.open(fifo, os.O_WRONLY | os.O_NONBLOCK))
            except OSError:
                pass
            if touch:
                quietly(touch.close)
            if keyboard:
                quietly(keyboard.close)
            quietly(remove_monitor)
            shutil.rmtree(tmp, ignore_errors=True)
            log("display session ended")
            notify("Phone display disconnected")

    def loop(self, sock, frames, touch, keyboard, rec):
        """Single-threaded pump: send frames, apply input, until either side stops."""
        buf = b""
        while True:
            try:
                frame = frames.get(timeout=0.004)
            except queue.Empty:
                frame = b""
            if frame is None or rec.poll() is not None:
                return
            if frame:
                sock.settimeout(10)
                sock.sendall(frame)
            sock.settimeout(0)
            while True:  # drain everything the phone has sent
                try:
                    chunk = sock.recv(16384)
                except (ssl.SSLWantReadError, BlockingIOError, socket.timeout):
                    break
                if not chunk:
                    return  # phone disconnected
                buf += chunk
                if len(buf) > 1 << 20:
                    raise RuntimeError("input flood")
            n = len(buf) // MSG.size * MSG.size
            for off in range(0, n, MSG.size):
                msg = MSG.unpack_from(buf, off)
                if msg[0] >= K_TAP:
                    if keyboard:
                        keyboard.handle(*msg)
                elif touch:
                    touch.handle(*msg)
            buf = buf[n:]

    # ---- UDP discovery for Wi-Fi
    def discovery(self):
        u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        u.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        u.bind(("0.0.0.0", PORT))
        reply = f"HYPRSCREEN-HERE {PROTO} {self.ident['id']} {self.hostname}".encode()
        while True:
            try:
                data, addr = u.recvfrom(256)
                if data.startswith(b"HYPRSCREEN-DISCOVER"):
                    u.sendto(reply, addr)
            except OSError as e:
                log(f"discovery: {e}")
                time.sleep(1)

    # ---- USB: pair over adb, then launch the app
    def pair_over_adb(self, serial):
        """Write the pairing record into the app's private storage (other apps can't read it)."""
        record = json.dumps({"id": self.ident["id"], "name": self.hostname,
                             "secret": self.ident["secret"], "fingerprint": self.ident["fingerprint"]})
        fd, path = tempfile.mkstemp(prefix="hypr-screen-pair-", dir=os.environ.get("XDG_RUNTIME_DIR"))
        try:
            with os.fdopen(fd, "w") as f:
                f.write(record)
            run("adb", "-s", serial, "shell", "mkdir", "-p", PAIR_DIR, check=False)
            run("adb", "-s", serial, "push", path, f"{PAIR_DIR}/pair-{self.ident['id']}.json")
        finally:
            os.unlink(path)

    def usb_watch(self):
        known = set()
        while True:
            try:
                out = run("adb", "devices", check=False, timeout=10)
                serials = {l.split()[0] for l in out.splitlines()[1:] if l.strip().endswith("\tdevice")}
                for s in serials - known:
                    if not run("adb", "-s", s, "shell", "pm", "path", PACKAGE, check=False, timeout=10):
                        continue  # app not installed on this device
                    try:
                        self.pair_over_adb(s)
                    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
                        log(f"pairing {s} failed: {e}")
                        continue
                    run("adb", "-s", s, "reverse", f"tcp:{PORT}", f"tcp:{PORT}", check=False)
                    log(f"USB phone {s} paired and ready")
                    if self.cfg["auto_usb"] and not self.busy.locked():
                        run("adb", "-s", s, "shell", "am", "start", "-n", f"{PACKAGE}/.MainActivity",
                            "--ez", "autoconnect_usb", "true", check=False)
                known = serials
            except (subprocess.TimeoutExpired, OSError) as e:
                log(f"adb: {e}")
            time.sleep(2)


UNIT_PATH = os.path.expanduser("~/.config/systemd/user/hypr-screen.service")
UNIT = """[Unit]
Description=Hypr Screen - use an Android phone as a Hyprland monitor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart={exe}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
"""


def service_exe():
    """Path the service should run. For mise, prefer the shim so upgrades keep working."""
    exe = os.path.realpath(os.path.abspath(sys.argv[0]))
    if "/mise/installs/" in exe:
        shim = os.path.join(os.environ.get("MISE_DATA_DIR", os.path.expanduser("~/.local/share/mise")),
                            "shims", "hypr-screen")
        if os.path.exists(shim):
            return shim
    return exe


def install_service():
    missing = [t for t in ("hyprctl", "wf-recorder", "adb", "openssl") if not shutil.which(t)]
    if missing:
        pkgs = " ".join("android-tools" if t == "adb" else t for t in missing)
        sys.exit(f"missing: {', '.join(missing)}  (Arch: sudo pacman -S {pkgs})")
    exe = service_exe()
    if any(c.isspace() or c in "%\\\"'" for c in exe):
        sys.exit(f"can't use a path with spaces or quotes in a systemd unit: {exe}")
    os.makedirs(os.path.dirname(UNIT_PATH), exist_ok=True)
    with open(UNIT_PATH, "w") as f:
        f.write(UNIT.format(exe=exe))
    for cmd in (["daemon-reload"], ["enable", "hypr-screen.service"], ["restart", "hypr-screen.service"]):
        subprocess.run(["systemctl", "--user", *cmd], check=True)
    print(f"hypr-screen service installed and running ({exe}).\n")
    print("USB: plug in your phone (USB debugging on) with the Hypr Screen app installed.")
    print('Wi-Fi: set "wifi": true in ~/.config/hypr-screen/config.json, run')
    print("  systemctl --user restart hypr-screen")
    print("and, with ufw, allow your LAN only, e.g.: sudo ufw allow from 192.168.1.0/24 to any port 7878")
    print("Then tap Pair in the phone app and type the code it shows into the window on the laptop.")


def uninstall_service():
    subprocess.run(["systemctl", "--user", "disable", "--now", "hypr-screen.service"], check=False)
    if os.path.exists(UNIT_PATH):
        os.unlink(UNIT_PATH)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    print("hypr-screen service removed. Pairing keys stay in ~/.config/hypr-screen (delete it to revoke them).")


def main():
    ap = argparse.ArgumentParser(description="Use an Android phone as a Hyprland monitor (background service).")
    ap.add_argument("--no-usb", action="store_true", help="don't watch for USB phones")
    ap.add_argument("--install-service", action="store_true",
                    help="install and start the systemd user service (starts with your Hyprland session)")
    ap.add_argument("--uninstall-service", action="store_true", help="stop and remove the systemd user service")
    ap.add_argument("--version", action="version", version=f"hypr-screen {VERSION}")
    ap.add_argument("--devices", action="store_true", help="list phones paired over Wi-Fi")
    ap.add_argument("--forget", metavar="DEVICE", help="remove a phone paired over Wi-Fi (id from --devices)")
    ap.add_argument("--confirm-pair", nargs=4, metavar=("RESULT", "NAME", "ADDR", "CODE"), help=argparse.SUPPRESS)
    args = ap.parse_args()
    if args.install_service:
        install_service()
        return
    if args.uninstall_service:
        uninstall_service()
        return
    if args.confirm_pair:
        confirm_pair(*args.confirm_pair)
        return
    if args.devices:
        devices = load_devices()
        for dev, info in devices.items():
            added = time.strftime("%Y-%m-%d", time.localtime(info.get("added", 0)))
            print(f"{dev}  {info.get('name', '?'):<24} paired {added}")
        if not devices:
            print("No phones paired over Wi-Fi. (USB pairing is reset by deleting ~/.config/hypr-screen/identity.json.)")
        return
    if args.forget:
        with DevicesLock():
            devices = load_devices()
            if devices.pop(args.forget, None) is None:
                sys.exit(f"no paired phone with id {args.forget} (see --devices)")
            save_devices(devices)
        print(f"Forgot {args.forget}. It can no longer connect.")
        return
    for tool in ("hyprctl", "wf-recorder", "openssl"):
        if not shutil.which(tool):
            sys.exit(f"{tool} not found (sudo pacman -S {tool})")

    cfg = load_config()
    d = Daemon(cfg, load_identity())
    remove_monitor()  # leftover from a crash
    signal.signal(signal.SIGTERM, lambda *_: (remove_monitor(), os._exit(0)))
    if cfg["wifi"]:
        threading.Thread(target=d.discovery, daemon=True).start()
    if shutil.which("adb") and not args.no_usb:
        threading.Thread(target=d.usb_watch, daemon=True).start()
    try:
        d.serve()
    except KeyboardInterrupt:
        remove_monitor()


if __name__ == "__main__":
    main()
